# dependencies
node_modules/
.pnp
.pnp.js

# env / secrets
# Catch-all rather than naming each file: a stray copy like
# .env.local.bak or .env.production.backup matched none of the specific
# patterns and would have been picked up by `git add -A`.
.env*
!.env.example

# build output
.next/
out/
dist/
build/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# misc
*.tsbuildinfo
.turbo/
coverage/
next-env.d.ts

# vercel
.vercel

/src/generated/prisma

# Operational notes - services, env layout, DNS, quotas. Local only:
# infrastructure detail, not something a public repo should ship.
docs/OPERATIONS.md

# Personal working preferences - about the maintainer, not the software.
docs/LAUNCH_CHECKLIST.md

# Personal working notes and build plans, CLAUDE.local.md included - about
# the maintainer or a feature's construction, not documentation of either.
*.local.md

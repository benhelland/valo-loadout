# Copy to .env.local and fill in. Never commit the real .env* files (see .gitignore).

# --- Database ---
DATABASE_URL=

# --- App auth (our own accounts, not Riot's) ---
AUTH_SECRET=

# --- Encryption key for storing linked Riot session tokens at rest ---
# Generate a real random secret before Phase 3 (account linking). Never reuse
# this for anything else.
RIOT_TOKEN_ENCRYPTION_KEY=

# --- Notifications ---
# Pick whichever channel(s) Phase 3 actually implements first.
RESEND_API_KEY=
DISCORD_WEBHOOK_URL=

# --- Content sync ---
# valorant-api.com is unofficial and (as of writing) doesn't require a key,
# but double check when the sync job is actually built.
VALORANT_API_BASE_URL=https://valorant-api.com/v1

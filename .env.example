# Copy to .env.local and fill in. Never commit the real .env* files (see .gitignore).

# --- Database (Neon) ---
# Pooled connection - used by the app at runtime (src/lib/db.ts)
DATABASE_URL=
# Direct (unpooled) connection - used by the Prisma CLI for migrations (prisma.config.ts)
DIRECT_URL=

# --- Maintenance mode (global off switch - src/proxy.ts) ---
# Set to exactly "1" to serve a 503 maintenance page for every request.
# Handled in the proxy layer, before any route renders, so a site in
# maintenance mode costs no database compute at all. Any other value is off.
MAINTENANCE_MODE=
# Lets you through while everyone else sees the notice - without it the
# switch is blinding. Visit any URL with ?maintenance-bypass=<value> once to
# set a cookie. Leave empty to allow no bypass at all (fails closed).
#   openssl rand -base64 24
MAINTENANCE_BYPASS_SECRET=

# --- Neon management API (src/scripts/setNeonQuota.ts only, never used at runtime) ---
# Neon's console has no spend cap - only email alerts, which report a growing
# bill without stopping it. The only hard ceiling is the project's quota
# object, settable through this API alone.
#
# NOTE: these select which project is *administered*, which is a different
# axis from DATABASE_URL / DIRECT_URL selecting which database the app *talks
# to*. It is normal and correct for them to point at different environments -
# a dev database to code against, the production project to cap, because
# production is the one that bills. The script prints the project name before
# it writes anything, so a mix-up is visible rather than silent.
#
# Use a project-scoped API key, not a personal one: personal keys reach every
# project in the org, project-scoped keys get Editor rights on just this one
# and cannot delete it.
NEON_API_KEY=
NEON_PROJECT_ID=

# The ceiling itself. All five are required by `npm run neon-quota -- --apply`:
# Neon reads a missing value as unlimited, so a partial set would leave the
# forgotten field uncapped. Reaching any of them suspends the project's
# compute until the next billing period - a hard stop, not a throttle.
NEON_QUOTA_COMPUTE_SECONDS=
NEON_QUOTA_ACTIVE_SECONDS=
NEON_QUOTA_TRANSFER_BYTES=
NEON_QUOTA_WRITTEN_BYTES=
NEON_QUOTA_LOGICAL_SIZE_BYTES=

# --- App auth (our own accounts via Discord OAuth - see docs/ARCHITECTURE.md) ---
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Discord bot (automatic notifications - see docs/ARCHITECTURE.md "Notifications") ---
# A bot can only DM a user it shares a server with, so every Discord sign-in
# also silently adds the user to this app's own Discord server (via the
# `guilds.join` OAuth scope - src/auth.ts) - no separate manual step for the
# user. Requires a Discord Application with a bot user, invited to that
# server with at least the CREATE_INSTANT_INVITE permission.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Base URL used to build links inside Discord notification messages.
# Defaults to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_APP_URL=

# --- Encryption key for storing linked Riot session cookies at rest ---
# Required by src/lib/crypto.ts (AES-256-GCM). Must decode to exactly 32 bytes:
#   openssl rand -base64 32
# Rotating this makes every already-linked Riot account undecryptable (users
# would have to re-link), so don't churn it. Never reuse it for anything else.
RIOT_TOKEN_ENCRYPTION_KEY=

# --- Shared secret for the scheduled shop-check route ---
# Protects GET /api/cron/check-shops, which makes outbound calls to Riot.
# Vercel Cron sends it as `Authorization: Bearer <value>`. If unset, that route
# fails closed (503) rather than running unauthenticated.
#   openssl rand -base64 32
# Not needed if you only ever run the job via `npm run check-shops`.
CRON_SECRET=

# --- Content sync ---
# valorant-api.com is unofficial and (as of writing) doesn't require a key,
# but double check when the sync job is actually built.
VALORANT_API_BASE_URL=https://valorant-api.com/v1

# --- Vibe-tagging (Phase 1 sync job - see docs/ARCHITECTURE.md) ---
# Ingest-time only, one call per new skin. Fill in when the tagging pipeline is built.
ANTHROPIC_API_KEY=

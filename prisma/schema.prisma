// Prisma schema for valo-loadout.
// Mirrors the data model documented in docs/ARCHITECTURE.md - keep both in sync.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth (Auth.js / NextAuth, Discord OAuth only, JWT sessions - no Session table needed) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? // required by @auth/prisma-adapter's AdapterUser shape - the OAuth
  // sign-in path (handle-login.js in @auth/core) unconditionally passes
  // `emailVerified: null` to createUser even for OAuth-only setups with no
  // email provider configured. Without this column the very first Discord
  // sign-in throws a Prisma "unknown argument" error - confirmed by reading
  // the adapter's actual source rather than assuming the schema was already
  // adapter-compatible just because it looked complete.
  image     String?
  createdAt DateTime @default(now())

  accounts           Account[]
  loadouts           Loadout[]
  wishlistItems      WishlistItem[]
  linkedRiotAccounts LinkedRiotAccount[]
  notificationsSent  NotificationSent[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// --- Content layer (synced from valorant-api.com, not user-editable) ---

model Weapon {
  id             String @id // uuid from valorant-api.com
  displayName    String
  category       String?
  displayIconUrl String?

  skins        Skin[]
  loadoutItems LoadoutItem[]

  @@map("weapons")
}

model ContentTier {
  id             String  @id
  displayName    String
  devName        String
  rank           Int
  highlightColor String?
  displayIconUrl String?

  skins Skin[]

  @@map("content_tiers")
}

model Theme {
  id             String  @id
  displayName    String
  displayIconUrl String?

  skins Skin[]

  @@map("themes")
}

model Skin {
  id                String   @id // uuid from valorant-api.com
  weaponId          String?
  weapon            Weapon?  @relation(fields: [weaponId], references: [id])
  displayName       String
  contentTierId     String?
  contentTier       ContentTier? @relation(fields: [contentTierId], references: [id])
  themeId           String?
  theme             Theme?   @relation(fields: [themeId], references: [id])
  displayIconUrl    String?
  colorFamily       String? // extracted from the base/first chroma's image at sync time
  firstSeenInSyncAt DateTime @default(now())
  // Real VP price, from Riot's own store offers endpoint via a linked
  // account (src/riot/store.ts fetchOfferPrices -> syncSkinPrices). Null
  // means "not directly purchasable, or not seen in the offer list" - battle
  // pass / event / agent-contract skins have no VP price at all, and null is
  // a truthful answer for those rather than a fabricated one.
  //
  // This replaced a static tier-based estimate that was structurally unable
  // to be right: it keyed off rarity alone, so every melee skin (175 of them,
  // all tier "Exclusive") was priced identically to an Exclusive *gun*,
  // understating knives by thousands of VP. See src/lib/pricing.ts.
  priceVp           Int?
  // Still no release-date column: valorant-api.com exposes none, and our own
  // firstSeenInSyncAt is an insert time, not a release date - see
  // docs/ARCHITECTURE.md.

  levels            SkinLevel[]
  chromas           SkinChroma[]
  vibeTags          SkinVibeTag[]
  loadoutItems      LoadoutItem[]
  wishlistItems     WishlistItem[]
  sightingStats     SkinSightingStat[]
  notificationsSent NotificationSent[]

  @@index([weaponId])
  @@index([contentTierId])
  @@index([themeId])
  @@map("skins")
}

model SkinLevel {
  id             String  @id // uuid from valorant-api.com
  skinId         String
  skin           Skin    @relation(fields: [skinId], references: [id], onDelete: Cascade)
  levelIndex     Int
  displayIconUrl String? // confirmed nullable on some levels
  videoUrl       String? // confirmed nullable on most levels
  levelItem      String? // raw API enum, e.g. "EEquippableSkinLevelItem::SoundEffects"

  loadoutItems LoadoutItem[]

  @@index([skinId])
  @@map("skin_levels")
}

model SkinChroma {
  id             String  @id // uuid from valorant-api.com
  skinId         String
  skin           Skin    @relation(fields: [skinId], references: [id], onDelete: Cascade)
  chromaIndex    Int     @default(0) // position in the API's own chromas[] array - the base/default chroma is always index 0, recolors follow. Without this, chroma order from a query is unspecified and the "default" chroma can't be reliably identified (confirmed bug: some skins' first-returned row was actually a recolor).
  displayName    String?
  displayIconUrl String?
  fullRenderUrl  String?
  swatchUrl      String? // confirmed often null on the default chroma - fall back to fullRenderUrl/displayIconUrl
  colorFamily    String? // extracted per-chroma
  videoUrl       String?

  loadoutItems LoadoutItem[]

  @@index([skinId])
  @@map("skin_chromas")
}

model SkinVibeTag {
  skinId String
  skin   Skin   @relation(fields: [skinId], references: [id], onDelete: Cascade)
  tag    String // from a fixed vocabulary, AI-assigned at sync time - see docs/ARCHITECTURE.md

  @@id([skinId, tag])
  @@index([tag])
  @@map("skin_vibe_tags")
}

model Buddy {
  id             String  @id // uuid from valorant-api.com
  displayName    String
  displayIconUrl String?
  colorFamily    String? // extracted from displayIconUrl at sync time, same pipeline as skins/chromas - powers the buddy gallery's color filter so a buddy can be matched to a skin's palette

  levels       BuddyLevel[]
  loadoutItems LoadoutItem[]

  @@map("buddies")
}

model BuddyLevel {
  id             String  @id // uuid from valorant-api.com
  buddyId        String
  buddy          Buddy   @relation(fields: [buddyId], references: [id], onDelete: Cascade)
  charmLevel     Int
  displayIconUrl String?

  @@index([buddyId])
  @@map("buddy_levels")
}

// --- App layer (our own accounts, loadouts, wishlist) ---

model Loadout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  isShareable Boolean  @default(false) // opt-in - private by default
  shareSlug   String?  @unique // unguessable, separate from the internal id; regenerated on revoke
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LoadoutItem[]

  @@index([userId])
  @@map("loadouts")
}

model LoadoutItem {
  id        String      @id @default(cuid())
  loadoutId String
  loadout   Loadout     @relation(fields: [loadoutId], references: [id], onDelete: Cascade)
  weaponId  String // the "slot" - one item per weapon per loadout, mirrors the real game
  weapon    Weapon      @relation(fields: [weaponId], references: [id])
  skinId    String
  skin      Skin        @relation(fields: [skinId], references: [id])
  levelId   String?
  level     SkinLevel?  @relation(fields: [levelId], references: [id])
  chromaId  String?
  chroma    SkinChroma? @relation(fields: [chromaId], references: [id])
  buddyId   String?
  buddy     Buddy?      @relation(fields: [buddyId], references: [id])

  @@unique([loadoutId, weaponId])
  @@index([skinId])
  @@map("loadout_items")
}

model WishlistItem {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId  String
  skin    Skin     @relation(fields: [skinId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([userId, skinId])
  @@index([userId])
  @@map("wishlist_items")
}

// --- Store-check subsystem (isolated - see docs/ARCHITECTURE.md and docs/RISKS.md) ---

enum LinkedAccountStatus {
  ACTIVE
  EXPIRED
  ERROR
  CAPTCHA_BLOCKED
}

model LinkedRiotAccount {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AES-256-GCM ciphertext (src/lib/crypto.ts) of the Riot OAuth *refresh*
  // token. Never a password - we never receive one; see docs/ARCHITECTURE.md
  // "Store-check subsystem detail" for why the password flow was abandoned.
  //
  // Riot rotates this on every use, so it is rewritten on every successful
  // refresh. Two concurrent refreshes would each invalidate the other's token
  // and kill the link outright, which is what refreshLockedUntil prevents.
  encryptedRefreshToken String
  // Short-lived lease held while a refresh is in flight. A poll that can't
  // take the lease skips rather than racing.
  refreshLockedUntil    DateTime?
  region                String? // resolved shard from riot-geo affinities.live - the shop endpoint is region-specific
  // Needed to address the storefront endpoint (/store/v3/storefront/{puuid}).
  puuid                 String?
  // Shown on /account so a user can confirm *which* account got linked - the
  // only way to catch having pasted a cookie for the wrong account. Kept to
  // the in-game display name only, nothing further (data minimization).
  riotGameName          String?
  riotTagLine           String?
  status                LinkedAccountStatus @default(ACTIVE)
  // Short, non-sensitive reason string surfaced with an ERROR/EXPIRED status
  // so the user sees why re-linking is needed. Never contains a token.
  lastError             String?
  // Set the first time we DM the user that this link expired, so recordFailure
  // (src/store-check/) doesn't re-notify on every subsequent failed poll or
  // manual "check shop now" click. Cleared back to null on every successful
  // (re)link - see linkRiotAccount - so a future expiry notifies again.
  expiryNotifiedAt      DateTime?
  lastSyncedAt          DateTime?
  nextPollAt            DateTime? // derived from the account's own shop reset time, not a blind interval
  createdAt             DateTime            @default(now())

  sightingStats SkinSightingStat[]

  @@unique([userId, puuid])
  @@index([nextPollAt])
  @@index([userId])
  @@map("linked_riot_accounts")
}

model SkinSightingStat {
  linkedRiotAccountId String
  linkedRiotAccount   LinkedRiotAccount @relation(fields: [linkedRiotAccountId], references: [id], onDelete: Cascade)
  skinId              String
  skin                Skin              @relation(fields: [skinId], references: [id], onDelete: Cascade)
  firstSeenAt         DateTime          @default(now())
  lastSeenAt          DateTime          @default(now())
  timesSeen           Int               @default(1)
  // Upserted on every poll for every skin observed that day - bounded by catalog size, not time.
  // Powers "last seen N days ago" / "seen N times since you signed up." No raw daily log table.

  @@id([linkedRiotAccountId, skinId])
  @@map("skin_sighting_stats")
}

enum NotificationChannel {
  // A bot DM, not a manually-configured per-user webhook - see
  // docs/ARCHITECTURE.md "Notifications". Delivered automatically off the
  // user's existing Discord OAuth sign-in; no separate setup step.
  DISCORD_DM
}

model NotificationSent {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId    String
  skin      Skin                @relation(fields: [skinId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  sentAt    DateTime            @default(now())
  // Dedupe: src/notifications/ checks for an existing row within a rolling
  // window (roughly one shop cycle) before sending - see notifyWishlistMatches.

  @@index([userId, skinId, sentAt])
  @@map("notifications_sent")
}
